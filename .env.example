# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fut25

# Redis
REDIS_URL=redis://localhost:6379/0

# EA Configuration
TEST_MODE=false
SCRAPE_BATCH_SIZE=50

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure_password_here
PROMETHEUS_RETENTION_DAYS=15

# Adaptive Throttle Configuration
ADAPTIVE_THROTTLE_ENABLED=true
ADAPTIVE_ADJUSTMENT_INTERVAL=300
ADAPTIVE_MAX_FACTOR=3.0
ADAPTIVE_MIN_FACTOR=0.5

# Celery
CELERY_WORKER_CONCURRENCY=4

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_ERROR_THRESHOLD=0.5
CIRCUIT_BREAKER_RATE_LIMIT_THRESHOLD=10
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=0.7
CIRCUIT_BREAKER_RESPONSE_TIME_THRESHOLD=5.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=300
CIRCUIT_BREAKER_HALF_OPEN_CALLS=3