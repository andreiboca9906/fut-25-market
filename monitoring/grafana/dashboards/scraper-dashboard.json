{
  "id": null,
  "uid": "fut26-scraper",
  "title": "EA FC 26 Scraper Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 22,
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "title": "Players Without Prices by Rating (Count)",
      "type": "bargauge", 
      "targets": [
        {
          "expr": "sum by (rating_range) (sum by (rating_range, pid) (fc26_total_players_by_rating) - sum by (rating_range, pid) (fc26_players_with_prices_by_rating))",
          "legendFormat": "{{rating_range}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "vertical",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "short"
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "rating_range",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 23,
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "title": "Players With Prices Ratio by Rating (%)",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum by (rating_range) (sum by (rating_range, pid) (fc26_players_with_prices_by_rating)) / sum by (rating_range) (sum by (rating_range, pid) (fc26_total_players_by_rating)) * 100",
          "legendFormat": "{{rating_range}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "vertical",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "green", "value": 80}
            ]
          },
          "unit": "percent"
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "rating_range",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 1,
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "title": "Request Rate by Tier",
      "type": "graph",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (tier, status) (sum by (tier, status, pid) (rate(fc26_scraper_requests_total[5m])))",
          "legendFormat": "{{tier}} - {{status}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "short", "logBase": 1, "show": true},
        {"format": "short", "logBase": 1, "show": true}
      ],
      "xaxis": {"show": true}
    },
    {
      "id": 2,
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "title": "Response Time Percentiles",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (tier, le) (sum by (tier, le, pid) (rate(fc26_scraper_response_time_seconds_bucket[5m]))))",
          "legendFormat": "P95 - {{tier}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (tier, le) (sum by (tier, le, pid) (rate(fc26_scraper_response_time_seconds_bucket[5m]))))",
          "legendFormat": "P99 - {{tier}}",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "s", "logBase": 1, "show": true},
        {"format": "short", "logBase": 1, "show": true}
      ],
      "xaxis": {"show": true}
    },
    {
      "id": 3,
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "title": "Success Rate by Tier",
      "type": "graph",
      "targets": [
        {
          "expr": "sum by (tier) (sum by (tier, status, pid) (rate(fc26_scraper_requests_total{status=\"success\"}[5m]))) / sum by (tier) (sum by (tier, status, pid) (rate(fc26_scraper_requests_total[5m]))) * 100",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"format": "percent", "logBase": 1, "show": true, "min": 0, "max": 100},
        {"format": "short", "logBase": 1, "show": true}
      ],
      "xaxis": {"show": true}
    },
    {
